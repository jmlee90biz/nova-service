Modules.Modules.productcataloginternal .[#cc0000,thickness=2].> Modules.Modules.productcatalogapi : "<color:#cc0000>uses"
Modules.Modules.customerprofileinternal .[#0000cc,thickness=2].> Modules.Modules.customerprofileevent : "<color:#0000cc>depends on"
Modules.Modules.customerprofileinternal .[#cc0000,thickness=2].> Modules.Modules.customerprofileapi : "<color:#cc0000>uses"
Modules.Modules.commonnotification .[#00aa00,thickness=2].> Modules.Modules.productcatalogevent : "<color:#00aa00>listens to"
Modules.Modules.commonnotification .[#00aa00,thickness=2].> Modules.Modules.customerprofileevent : "<color:#00aa00>listens to"
Modules.Modules.productpricingapi .[#0000cc,thickness=2].> Modules.Modules.productcatalogapi : "<color:#0000cc>depends on"
Modules.Modules.customersubscriptioninternal .[#0000cc,thickness=2].> Modules.Modules.customersubscriptionevent : "<color:#0000cc>depends on"
Modules.Modules.customersubscriptioninternal .[#cc0000,thickness=2].> Modules.Modules.customersubscriptionapi : "<color:#cc0000>uses"
Modules.Modules.customersubscriptioninternal .[#cc0000,thickness=2].> Modules.Modules.customerprofileapi : "<color:#cc0000>uses"
Modules.Modules.customersubscriptioninternal .[#cc0000,thickness=2].> Modules.Modules.productpricingapi : "<color:#cc0000>uses"
Modules.Modules.billingusageinternal .[#0000cc,thickness=2].> Modules.Modules.billingusageevent : "<color:#0000cc>depends on"
Modules.Modules.billingusageinternal .[#cc0000,thickness=2].> Modules.Modules.billingusageapi : "<color:#cc0000>uses"
@enduml