Modules.Modules.billinginvoiceinternal .[#00aa00,thickness=2].> Modules.Modules.billingusageevent : "<color:#00aa00>listens to"
Modules.Modules.billinginvoiceinternal .[#00aa00,thickness=2].> Modules.Modules.customersubscriptionevent : "<color:#00aa00>listens to"
Modules.Modules.billinginvoiceinternal .[#cc0000,thickness=2].> Modules.Modules.billinginvoiceapi : "<color:#cc0000>uses"
